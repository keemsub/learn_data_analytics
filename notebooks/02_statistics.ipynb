   "source": [
    "import statistics\n",
    "\n",
    "sales = [120, 150, 170, 100, 130, 140, 160, 180, 190, 110, 145, 175]\n",
    "\n",
    "print('평균:', statistics.mean(sales))\n",
    "print('중앙값:', statistics.median(sales))\n",
    "print('분산:', statistics.pvariance(sales))\n",
    "print('표준편차:', statistics.pstdev(sales))"
   ]
  }
